<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.evolucao-gaming.pt"
           xmlns="http://www.evolucao-gaming.pt"
           elementFormDefault="qualified">

    <xs:element name="game_evolution">
        <xs:complexType>
            <xs:sequence>
                
                <xs:element name="era" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            
                            <xs:element name="evento" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="imagem" type="xs:string" minOccurs="0"/>
                                        <xs:element name="ano_fund" minOccurs="1">
                                        <xs:simpleType>
                                        <xs:restriction base="xs:integer">
                                            <xs:minInclusive value="1950"/>
                                        </xs:restriction>
                                        </xs:simpleType>
                                        </xs:element>
                                        <xs:element name="titulo" type="xs:string" minOccurs="0"/>
                                        <xs:element name="consola" type="xs:string" minOccurs="0"/>
                                        <xs:element name="jogo_iconico" type="xs:string" minOccurs="0"/>
                                        
                                        <!-- O elemento preco agora é obrigatório (sem minOccurs="0") e do tipo inteiro -->
                                        <xs:element name="preco" minOccurs="0">
                                        <xs:simpleType>
                                        <xs:restriction base="xs:decimal">
                                        <xs:minInclusive value="0"/>
                                        </xs:restriction>
                                        </xs:simpleType>
                                        </xs:element>
                                        <xs:element name="descricao" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            
                        </xs:sequence>
                        <xs:attribute name="decada" type="xs:integer" use="required"/>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>